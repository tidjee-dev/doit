{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tidjee-dev/doit/schema.json",
  "title": "Doit Task Runner Schema",
  "type": "object",
  "required": [ "app", "tasks" ],
  "properties": {
    "app": {
      "type": "object",
      "required": [ "name", "version", "description", "main_file", "author", "repo_url" ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "main_file": {
          "type": "string",
          "pattern": "^.+\\.go$"
        },
        "author": {
          "type": "string"
        },
        "repo_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },

    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    }
  },

  "$defs": {
    "task": {
      "type": "object",
      "required": [ "category", "description", "commands" ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
